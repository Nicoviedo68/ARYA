APP_NAME=Arya
APP_ENV=local
APP_DEBUG=true
# LOCAL: http://localhost:8080  |  PRODUCCIÓN: https://app.aisscol.com/Arya/public
# Si subes localhost a Hostinger, el código lo ignora y usa el host del request.
APP_URL=https://app.aisscol.com/Arya/public
APP_KEY=change-me
# LOCAL php -S: false  |  Hostinger: true
APP_FORCE_INDEX_PHP=true
SESSION_LIFETIME=480

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=disable
DB_HOST=cortech_arya
DB_PORT=5432
DB_NAME=Arya
DB_USER=nico
DB_PASSWORD=
DB_SSLMODE=disable

N8N_WEBHOOK_URL=
N8N_API_KEY=

# OpenAI (Chat GPT / mejora omnicanal). Preferible guardar la key en Configuración → Integraciones.
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-5.6

# LOCAL: http://localhost:8081  |  PRODUCCIÓN: https://app.aisscol.com/ocp_Arya
OCP_URL=https://app.aisscol.com/ocp_Arya
OCP_LABEL=OCP Arya
OCP_2FA_WEBHOOK=

# Meta Business webhook (mensajes WhatsApp / Messenger / Instagram)
META_WEBHOOK_URL=https://app.aisscol.com/Arya/public/api/meta-webhook.php
# Opcional: si vacío, se genera y guarda en meta_webhook_config
META_VERIFY_TOKEN=
